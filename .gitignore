# Data (never commit MovieLens or derived rating artifacts)
data/

# Trained ranker binaries (recreate: movielens-recommender run --config configs/<dataset>.yaml)
models/

# Serving snapshot for the Streamlit demo (recreate: movielens-recommender build-artifacts)
artifacts/

# Space parameter files and a local GroupLens download (ADR-0020).
# space/.gitignore does not ignore weights/, so a push of that folder can include them.
space/weights/
space/data/
space/.runtime/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
.env

# Test / tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# IDE / OS
.idea/
.vscode/
.DS_Store
*.swp

# Netlify
.netlify

# Matplotlib
matplotlibrc
